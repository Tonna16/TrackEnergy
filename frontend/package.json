{
   "name": "energyiq",
   "private": true,
   "version": "0.1.0",
   "type": "module",
   "engines": {
      "node": ">=20"
   },
   "scripts": {
      "dev": "vite",
      "dev:fullstack": "vite --mode fullstack",
      "build": "tsc -b --force && vite build",
