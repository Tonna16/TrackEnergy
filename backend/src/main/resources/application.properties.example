# ===================================================================
# EnergyIQ backend configuration template
# -------------------------------------------------------------------
# Copy this file to application.properties for local-only customization
# OR set equivalent environment variables in your shell/CI/deployment.
# Never commit real secrets to git.
# ===================================================================

# Application name
spring.application.name=backend

# Datasource Config (defaults to local H2; override for PostgreSQL)
spring.datasource.url=${DB_URL:jdbc:h2:file:./data/energy_tracker;MODE=PostgreSQL;AUTO_SERVER=TRUE}
spring.datasource.username=${DB_USERNAME:sa}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=${DB_DRIVER:org.h2.Driver}
# For PostgreSQL, set DB_URL like: jdbc:postgresql://localhost:5432/energy_tracker
# and set DB_USERNAME/DB_PASSWORD (and optionally JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect).

# JPA & Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false
logging.level.com.energytracker=INFO

# JWT
# Generate a long random secret for production (at least 64 bytes).
jwt.secret=${JWT_SECRET:change_me_jwt_secret_change_me_jwt_secret_32b}
jwt.access-expiration-ms=900000
jwt.refresh-expiration-ms=604800000

# Frontend origin(s)
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}

# Auth cookies
# For HTTPS production, set AUTH_COOKIE_SECURE=true.
# For local HTTP development, keep AUTH_COOKIE_SECURE=false so browser persists cookies.
app.auth.cookie.secure=${AUTH_COOKIE_SECURE:false}
app.auth.cookie.refresh.same-site=${AUTH_COOKIE_REFRESH_SAME_SITE:Strict}
app.auth.cookie.refresh.path=${AUTH_COOKIE_REFRESH_PATH:/api/auth}
app.auth.cookie.csrf.same-site=${AUTH_COOKIE_CSRF_SAME_SITE:Strict}
app.auth.cookie.csrf.path=${AUTH_COOKIE_CSRF_PATH:/}
